# ==========================================
# Telegram MTProto User API Credentials
# Get your API ID and Hash from https://my.telegram.org
# ==========================================
API_ID=12345678
API_HASH="0123456789abcdef0123456789abcdef"
PHONE_NUMBER="+1234567890"
SESSION_NAME="tg_indexer_session"

# ==========================================
# Telegram Bot Token for Search Interface
# Create a new bot via @BotFather in Telegram
# ==========================================
BOT_TOKEN="123456789:ABCdefGHIjklMNOpqrSTUvwxYZ"

# ==========================================
# Database Configuration
# SQLite (Async) for local development:
DATABASE_URL="sqlite+aiosqlite:///./telegram_directory.db"

# PostgreSQL (Async) for production:
# DATABASE_URL="postgresql+asyncpg://postgres:password@localhost:5432/telegram_directory"

# ==========================================
# Anti-Flood & Rate Limiting Settings
# ==========================================
REQUEST_DELAY_MIN=3.0
REQUEST_DELAY_MAX=6.0
BATCH_PAUSE_SECONDS=30.0
MAX_MEMBERS_PER_GROUP=5000
SEARCH_PAGE_SIZE=8
